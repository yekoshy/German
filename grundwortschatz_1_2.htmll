<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grundwortschatz Deutsch - Lern-App</title>
    <style>
        /* Kinderfreundliches Design & große Schriften */
        :root {
            --primary: #FF9800;
            --bg-color: #E0F7FA;
            --text-color: #333;
            --card-bg: #ffffff;
        }

        body {
            font-family: 'Comic Sans MS', 'Chalkboard SE', 'Nunito', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            text-align: center;
            margin: 0;
            padding: 20px;
        }

        h1 {
            font-size: 2.5rem;
            color: #00838F;
            margin-bottom: 10px;
        }

        p {
            font-size: 1.5rem;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: var(--card-bg);
            padding: 30px;
            border-radius: 30px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        /* Screens (Menü & Spiele) */
        .screen {
            display: none;
            animation: fadeIn 0.5s;
        }
        .screen.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }

        /* Buttons */
        button {
            font-family: inherit;
            font-size: 1.8rem;
            padding: 15px 30px;
            margin: 15px;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            box-shadow: 0 5px 0px rgba(0,0,0,0.2);
            transition: transform 0.1s, box-shadow 0.1s;
        }

        button:active {
            transform: translateY(5px);
            box-shadow: 0 0px 0px rgba(0,0,0,0.2);
        }

        .btn-menu { background-color: #FFC107; color: #333; font-weight: bold; width: 80%; max-width: 400px; }
        .btn-der { background-color: #4FC3F7; color: white; }
        .btn-die { background-color: #F06292; color: white; }
        .btn-das { background-color: #81C784; color: white; }
        .btn-back { background-color: #E0E0E0; font-size: 1.2rem; padding: 10px 20px; margin-top: 30px; }
        .btn-word { background-color: #BA68C8; color: white; display: block; width: 80%; margin: 15px auto; }
        
        .btn-category { background-color: #4DB6AC; color: white; width: 40%; display: inline-block;}

        /* Spiel-Elemente */
        .big-word {
            font-size: 4rem;
            font-weight: bold;
            color: #D84315;
            margin: 30px 0;
            min-height: 80px;
        }

        .feedback {
            font-size: 2rem;
            font-weight: bold;
            height: 40px;
            margin-bottom: 20px;
        }

        .success { color: #2E7D32; }
        .error { color: #C62828; }

        /* Konfetti */
        .celebration {
            font-size: 5rem;
            margin: 20px 0;
        }
    </style>
</head>
<body>

<div class="container">
    
    <!-- HAUPTMENÜ -->
    <div id="menu-screen" class="screen active">
        <h1>🌟 Lern-App Deutsch 🌟</h1>
        <p>1. und 2. Klasse</p>
        <p>Wähle ein Spiel aus:</p>
        <button class="btn-menu" onclick="startGame(1)">1. Artikel finden 🍎</button>
        <button class="btn-menu" onclick="startGame(2)">2. Was passt nicht? 🔍</button>
        <button class="btn-menu" onclick="startGame(3)">3. Wörter sortieren 🧠</button>
    </div>

    <!-- SPIEL 1: Artikel (der, die, das) -->
    <!-- Basiert auf Seite 5 (Begleiter finden) -->
    <div id="game1-screen" class="screen">
        <h1>Welcher Begleiter passt?</h1>
        <p>Tippe auf den richtigen Artikel.</p>
        <div class="big-word" id="g1-word">Apfel</div>
        <div id="g1-feedback" class="feedback"></div>
        <div>
            <button class="btn-der" onclick="checkG1('der')">der</button>
            <button class="btn-die" onclick="checkG1('die')">die</button>
            <button class="btn-das" onclick="checkG1('das')">das</button>
        </div>
        <button class="btn-back" onclick="showMenu()">🏠 Zurück zum Menü</button>
    </div>

    <!-- SPIEL 2: Welches Wort passt nicht? -->
    <!-- Basiert auf Seite 7 (Reihen durchstreichen) -->
    <div id="game2-screen" class="screen">
        <h1>Was passt nicht?</h1>
        <p>Tippe auf das Wort, das <b>nicht</b> zu den anderen passt!</p>
        <div id="g2-feedback" class="feedback"></div>
        <div id="g2-buttons">
            <!-- Buttons werden per JS geladen -->
        </div>
        <button class="btn-back" onclick="showMenu()">🏠 Zurück zum Menü</button>
    </div>

    <!-- SPIEL 3: Wörter sortieren -->
    <!-- Basiert auf Seite 11 (Tabelle: Kalender vs. Mensch) -->
    <div id="game3-screen" class="screen">
        <h1>Wohin gehört das Wort?</h1>
        <div class="big-word" id="g3-word">Minute</div>
        <div id="g3-feedback" class="feedback"></div>
        <div>
            <button class="btn-category" onclick="checkG3('Zeit')">📅 Kalender & Zeit</button>
            <button class="btn-category" onclick="checkG3('Mensch')">👤 Der Mensch</button>
        </div>
        <button class="btn-back" onclick="showMenu()">🏠 Zurück zum Menü</button>
    </div>

    <!-- ENDBILDSCHIRM -->
    <div id="end-screen" class="screen">
        <h1>Klasse gemacht! 🥳</h1>
        <div class="celebration">⭐ 🎈 ⭐</div>
        <p>Du hast alle Aufgaben richtig gelöst!</p>
        <button class="btn-menu" onclick="showMenu()">🏠 Zurück zum Menü</button>
    </div>

</div>

<script>
    // --- DATEN FÜR DIE SPIELE ---

    // Spiel 1: Artikel (der, die, das)
    const g1_data = [
        { word: "Apfel", article: "der" },
        { word: "Blume", article: "die" },
        { word: "Buch", article: "das" },
        { word: "Baum", article: "der" },
        { word: "Kind", article: "das" },
        { word: "Sonne", article: "die" },
        { word: "Auto", article: "das" },
        { word: "Nase", article: "die" }
    ];

    // Spiel 2: Was passt nicht? (Aus dem PDF Seite 7)
    const g2_data = [
        { words: ["Fuß", "Feld", "Finger", "Bauch"], odd: "Feld" },
        { words: ["Donnerstag", "Freitag", "Woche", "Dienstag"], odd: "Woche" },
        { words: ["Fisch", "Ente", "dunkel", "Eule"], odd: "dunkel" },
        { words: ["eins", "flüssig", "fünf", "sechs"], odd: "flüssig" }
    ];

    // Spiel 3: Kategorien (Aus dem PDF Seite 11)
    const g3_data = [
        { word: "Minute", cat: "Zeit" },
        { word: "Kopf", cat: "Mensch" },
        { word: "Jahr", cat: "Zeit" },
        { word: "Auge", cat: "Mensch" },
        { word: "Montag", cat: "Zeit" },
        { word: "Bein", cat: "Mensch" },
        { word: "Herbst", cat: "Zeit" },
        { word: "Finger", cat: "Mensch" }
    ];


    // --- SPIEL LOGIK ---
    
    let currentIndex = 0;
    let currentGame = 0;

    // Navigation
    function hideAllScreens() {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    }

    function showMenu() {
        hideAllScreens();
        document.getElementById('menu-screen').classList.add('active');
        clearFeedback();
    }

    function showEndScreen() {
        hideAllScreens();
        document.getElementById('end-screen').classList.add('active');
    }

    function clearFeedback() {
        document.getElementById('g1-feedback').innerHTML = "";
        document.getElementById('g2-feedback').innerHTML = "";
        document.getElementById('g3-feedback').innerHTML = "";
    }

    // Spiel starten
    function startGame(gameNumber) {
        hideAllScreens();
        currentIndex = 0;
        currentGame = gameNumber;
        document.getElementById(`game${gameNumber}-screen`).classList.add('active');
        clearFeedback();
        
        if(gameNumber === 1) loadG1();
        if(gameNumber === 2) loadG2();
        if(gameNumber === 3) loadG3();
    }

    // --- Spiel 1 Logik ---
    function loadG1() {
        if (currentIndex >= g1_data.length) return showEndScreen();
        document.getElementById('g1-word').innerText = g1_data[currentIndex].word;
        document.getElementById('g1-feedback').innerText = "";
    }

    function checkG1(selected) {
        let correct = g1_data[currentIndex].article;
        let fb = document.getElementById('g1-feedback');
        
        if (selected === correct) {
            fb.innerHTML = "<span class='success'>Richtig! 🌟</span>";
            setTimeout(() => {
                currentIndex++;
                loadG1();
            }, 1000);
        } else {
            fb.innerHTML = "<span class='error'>Oh, versuche es nochmal! ❌</span>";
        }
    }

    // --- Spiel 2 Logik ---
    function loadG2() {
        if (currentIndex >= g2_data.length) return showEndScreen();
        
        let container = document.getElementById('g2-buttons');
        container.innerHTML = "";
        document.getElementById('g2-feedback').innerText = "";
        
        let row = g2_data[currentIndex];
        row.words.forEach(word => {
            let btn = document.createElement('button');
            btn.className = "btn-word";
            btn.innerText = word;
            btn.onclick = () => checkG2(word);
            container.appendChild(btn);
        });
    }

    function checkG2(selected) {
        let correct = g2_data[currentIndex].odd;
        let fb = document.getElementById('g2-feedback');
        
        if (selected === correct) {
            fb.innerHTML = "<span class='success'>Super! Das passt nicht dazu! 🌟</span>";
            setTimeout(() => {
                currentIndex++;
                loadG2();
            }, 1500);
        } else {
            fb.innerHTML = "<span class='error'>Fast! Schau noch mal genau hin! ❌</span>";
        }
    }

    // --- Spiel 3 Logik ---
    function loadG3() {
        if (currentIndex >= g3_data.length) return showEndScreen();
        document.getElementById('g3-word').innerText = g3_data[currentIndex].word;
        document.getElementById('g3-feedback').innerText = "";
    }

    function checkG3(selected) {
        let correct = g3_data[currentIndex].cat;
        let fb = document.getElementById('g3-feedback');
        
        if (selected === correct) {
            fb.innerHTML = "<span class='success'>Genau richtig! 🌟</span>";
            setTimeout(() => {
                currentIndex++;
                loadG3();
            }, 1000);
        } else {
            fb.innerHTML = "<span class='error'>Leider falsch, probiere es nochmal! ❌</span>";
        }
    }

</script>
</body>
</html>
